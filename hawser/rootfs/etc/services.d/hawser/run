#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

bashio::log.info "Starting Hawser agent"

# Map the addon options to environment variables expected by Hawser.
# Empty string options are skipped so that Hawser's own defaults stay active.
declare -A OPTION_MAP=(
    [PORT]=PORT
    [LOG_LEVEL]=LOG_LEVEL
    [BIND_ADDRESS]=BIND_ADDRESS
    [TOKEN]=TOKEN
    [AGENT_NAME]=AGENT_NAME
    [DOCKHAND_SERVER_URL]=DOCKHAND_SERVER_URL
    [TLS_CERT]=TLS_CERT
    [TLS_KEY]=TLS_KEY
    [CA_CERT]=CA_CERT
    [TLS_SKIP_VERIFY]=TLS_SKIP_VERIFY
    [HEARTBEAT_INTERVAL]=HEARTBEAT_INTERVAL
    [REQUEST_TIMEOUT]=REQUEST_TIMEOUT
    [RECONNECT_DELAY]=RECONNECT_DELAY
    [MAX_RECONNECT_DELAY]=MAX_RECONNECT_DELAY
)

for option in "${!OPTION_MAP[@]}"; do
    if bashio::config.has_value "${option}"; then
        value=$(bashio::config "${option}")
        export "${OPTION_MAP[$option]}=${value}"
    fi
done

# Persist stacks under /data so they survive addon updates
export STACKS_DIR="${STACKS_DIR:-/data/stacks}"
mkdir -p "${STACKS_DIR}"

# Pass-through for arbitrary extra environment variables
if bashio::config.has_value 'env_vars'; then
    for var in $(bashio::config 'env_vars|keys'); do
        name=$(bashio::config "env_vars[${var}].name")
        value=$(bashio::config "env_vars[${var}].value")
        bashio::log.info "Setting custom env: ${name}"
        export "${name}=${value}"
    done
fi

if bashio::config.has_value 'DOCKHAND_SERVER_URL'; then
    bashio::log.info "Edge mode: connecting to ${DOCKHAND_SERVER_URL}"
else
    bashio::log.info "Standard mode: listening on ${BIND_ADDRESS:-0.0.0.0}:${PORT:-2376}"
fi

cd /app 2>/dev/null || cd /
exec /usr/local/bin/hawser
